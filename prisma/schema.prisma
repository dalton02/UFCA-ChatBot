generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Usuario{
  id Int @id @default(autoincrement()) //Referente ao id firebase
  login String
  nome  String
  senha String?
  chats Chat[]
}

model Mensagem{
  id Int @id @default(autoincrement())
  chat Chat @relation(fields: [idChat],references: [id])
  idChat String @unique
}

model Chat{
  id String @id @default(uuid())
  mensagens Mensagem[]

  idUsuario Int
  usuario Usuario @relation(fields: [idUsuario],references: [id])
}